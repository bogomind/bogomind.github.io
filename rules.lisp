;; each rule from the post, as a test: equal under EQUALP => same hash in a table
(defvar *res* nil)
(defun rule (name a b)
  (let ((tbl (make-hash-table :test #'equalp)))
    (setf (gethash a tbl) :v)
    (push (cons name (nth-value 1 (gethash b tbl))) *res*)))
(rule "A integer = integral float" 1 1.0)
(rule "B dyadic ratio = float" 1/2 0.5)
(rule "C complex float = real" 42.0 #c(42.0 0.0))
(rule "D single float = double float" 0.5 0.5d0)
(rule "E -0.0 = 0.0" -0.0 0.0)
(rule "G bignum = bignum float" (expt 2 60) (float (expt 2 60) 1.0d0))
(rule "H vector of equal numbers" (vector 1/2) (vector 0.5))
(rule "I string equalp case" "abc" "ABC")
(dolist (r (reverse *res*))
  (format t "~a: ~a~%" (car r) (if (cdr r) "PASS" "FAIL")))
(format t "EQUALPCHECK-DONE~%")
