 "story": [
  {
   "text": "两扇门板，面对面站着。有的写法上面还加一根横木，那是门楣。",
   "ev": [
    [
     "cuhk",
     "甲金文均作兩扇門扉之形，甲骨文或於字上加上門楣"
    ]
   ]
  },
  {
   "text": "一扇的叫“户”，两扇的才叫“门”。《说文解字》说“门”是“从二户”：两个“户”拼成的。",
   "ev": [
    [
     "cuhk-戶",
     "一扉曰戶，兩扉曰門"
    ],
    [
     "shuowen",
     "从二戶。象形"
    ]
   ]
  },
  {
   "text": "门竟然还能当动词用。《左传》里晋国打曹国，“门焉”，意思是攻城门。",
   "ev": [
    [
     "cuhk",
     "晉侯圍曹，門焉，多死。』杜注云：『攻曹城門。』"
    ]
   ]
  },
  {
   "text": "商朝卜辞里的门，大多是宗庙的门。王会在宗庙门前，迎接抓了羌人俘虏回来的将领。",
   "ev": [
    [
     "cuhk",
     "甲骨多用「門」為宗廟之門"
    ],
    [
     "cuhk",
     "指王於宗廟的門前迎接獲得羌人俘虜而歸的將領"
    ]
   ]
  }
 ],
