 "story": [
  {
   "text": "一个人侧着身子站着，手垂下来。",
   "ev": [
    [
     "cuhk",
     "古文字「人」象人側面垂手侍立形"
    ],
    [
     "wikt",
     "side view of a standing man, highlighting an arm and a leg"
    ]
   ]
  },
  {
   "text": "这个“人”还被借去记数。商朝人竟然在“人”身上加一横，当作一千；加三横，就是三千。",
   "ev": [
    [
     "cuhk-千",
     "古人假借「人」字來表示千數，並增「一」以示「一千」之合文"
    ],
    [
     "cuhk-千",
     "甲金文有於「人」字加三畫以為「三千」"
    ]
   ]
  },
  {
   "text": "为什么借“人”？因为那时候，“人”和“千”读音相近。后来大家念“一千”常常省掉“一”，加了一横的“人”，就成了单独的“千”字。",
   "ev": [
    [
     "cuhk-千",
     "甲金文從「一」，「人」聲"
    ],
    [
     "cuhk-千",
     "後來由於古人讀「一千」常有省去「一」的習慣，故到後來「一千」的合文就成了單字「千」"
    ]
   ]
  },
  {
   "text": "商王提到自己，用的是“余一人”，意思是我这一个人。",
   "ev": [
    [
     "cuhk",
     "《合集》20328：「余一人」，是殷王自稱"
    ]
   ]
  },
  {
   "text": "“人”放到别的字左边，就成了单人旁“亻”。",
   "ev": [
    [
     "wikt",
     "The stylized version to the left of the characters is [[亻]]"
    ]
   ]
  }
 ],
