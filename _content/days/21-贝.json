 "story": [
  {
   "text": "一枚海贝的样子。",
   "ev": [
    [
     "cuhk",
     "「貝」字甲骨文象一種海貝"
    ]
   ]
  },
  {
   "text": "古人拿贝壳当钱。所以带“贝”的字，多半跟钱有关：财、货、贵、贱、赚、赔。",
   "ev": [
    [
     "cuhk",
     "古人以「貝」為貨幣。因此從「貝」之字一般與財貨和買賣有關"
    ]
   ]
  },
  {
   "text": "贝是论“朋”的：两串贝叫一朋。有件铜器上记着一次赏赐，一出手就是“赐贝三十朋”。",
   "ev": [
    [
     "cuhk-朋",
     "二繫貝為一「朋」"
    ],
    [
     "cuhk",
     "何尊：「易(賜)貝卅朋。」"
    ],
    [
     "cuhk",
     "古時兩串貝為一朋，本無定數"
    ]
   ]
  },
  {
   "text": "《说文解字》说，古时候“货贝而宝龟”，意思是拿贝当钱，拿龟当宝。到了秦朝，才废了贝，改用铜钱。",
   "ev": [
    [
     "shuowen",
     "古者貨貝而寶龜，周而有泉，至秦廢貝行錢"
    ]
   ]
  },
  {
   "text": "贝壳一开始就是钱吗？有一种说法，它竟然先是项链：串起来挂在脖子上，后来才成了钱。",
   "ev": [
