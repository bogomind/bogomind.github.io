 "near": {},
 "story": [
  {
   "text": "一匹马：长长的脸，脖子上一排鬃毛，下面是腿和尾巴。",
   "ev": [
    [
     "cuhk",
     "甲骨文象「馬」之形，字形特徵在於馬頸上有鬃毛"
    ],
    [
     "shuowen",
     "象馬頭髦尾四足之形"
    ]
   ]
  },
  {
   "text": "后来笔画越写越简单，可那排鬃毛一直舍不得丢。",
   "ev": [
    [
     "cuhk",
     "其後字形漸漸筆畫化，唯字形仍多會標示「馬」的鬃毛"
    ]
   ]
  },
  {
   "text": "汉朝有个官叫石建。他给皇帝上书，奏章退回来，他一看吓坏了：“写错了！‘马’字的腿加尾巴该是五笔，我只写了四笔。皇上要怪罪，我死定了！”",
   "ev": [
    [
     "shiji-wanshi",
     "建讀之，曰：「誤書！『馬』者與尾當五，今乃四，不足一。上譴死矣！」甚惶恐"
    ]
   ]
  },
  {
   "text": "少写一笔就怕掉脑袋，这人也太小心了。他这个人，做什么事都这么小心。",
   "ev": [
    [
     "shiji-wanshi",
     "其為謹愼，雖他皆如是"
    ]
   ]
  },
  {
   "text": "其实那时候的隶书，为了省事，马脚有时就少写一笔。",
   "ev": [
    [
     "cuhk",
     "漢隸由於簡省的關係，足形或少一筆"
    ]
   ]
  }
 ],
