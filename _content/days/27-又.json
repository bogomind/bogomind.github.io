 "hints": [
  "它画的是身体的一部分。",
  "可它今天的意思是“再一次”。",
  "常用词：__来了、__一次、__是。"
 ],
 "near": {
  "手": "它画的就是手！不过答案是另一个字。",
  "右": "非常接近！“右”就是它加了个“口”。"
 },
 "story": [
  {
   "text": "一只右手，从侧面看：上面伸出几根手指。",
   "ev": [
    [
     "cuhk",
     "甲金文象一隻右手形的側面，本義是右手"
    ]
   ]
  },
  {
   "text": "数一数，只有三根手指。少画两根，是画错了吗？《说文解字》说：手指头多，画三根就够了，“略不过三”。这理由也太干脆了。",
   "ev": [
    [
     "shuowen",
     "三指者，手之列多，略不過三也"
    ]
   ]
  },
  {
   "text": "其实它本来就是“右”。后来“又”被借去当“再一次”用，右手的意思，就交给了加了个“口”的“右”。",
   "ev": [
    [
     "cuhk",
     "後被假借為「再」、「更」意義的「又」，而以「右」專表示右手、左右之右"
    ],
    [
     "cuhk-右",
     "「右」的初文作「又」，象右手之形，金文加從「口」成「右」"
    ]
   ]
  },
  {
   "text": "在卜辞里，它还常常当“有”用：“又大雨”，意思是有大雨。",
   "ev": [
    [
     "cuhk",
     "又通作「有」，如卜辭「又(有)大雨」"
    ]
   ]
  }
 ],
