 "story": [
  {
   "text": "一个人，正面站着，叉开两条腿。",
   "ev": [
    [
     "cuhk",
     "「大」字象人正面站立"
    ]
   ]
  },
  {
   "text": "它最早的意思是“大人”，也就是成年人。跟它相对的是“子”，小孩儿。大人比小孩儿大，所以它慢慢有了“大”的意思。",
   "ev": [
    [
     "cuhk",
     "本義是成年人，與「子」象小孩相對"
    ],
    [
     "cuhk",
     "因年紀較小孩大，故引申有大義"
    ]
   ]
  },
  {
   "text": "没想到，在这个人头上加一短横，就成了“夫”。“大”和“夫”本来是一个字，后来才分开。",
   "ev": [
    [
     "cuhk",
     "古文字「大」、「夫」是一字之分化"
    ],
    [
     "cuhk",
     "後來才在「大」上加一短橫分化出「夫」字"
    ]
   ]
  },
  {
   "text": "那一横是什么？多数学者认为它只是装饰，没有意义。《说文解字》却说，那是一根簪子：小孩披着头发，成年男子才用簪子把头发束起来。",
   "ev": [
    [
     "cuhk",
     "學者多認為一短橫是沒有意義的飾筆"
    ],
    [
     "shuowen-夫",
     "从大，一以象簪也"
    ],
    [
     "cuhk-夫",
     "古代的男性，童子披髮，成人則以簪束髮"
    ]
   ]
  }
 ],
