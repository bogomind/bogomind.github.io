 "hints": [
  "一种个头很大的动物。",
  "它有一条长长的鼻子。",
  "常用词：大__、__牙、想__。"
 ],
 "near": {
  "像": "非常接近！“像”就是从它分出来的。"
 },
 "story": [
  {
   "text": "从侧面看一头大象，最显眼的，就是那条长鼻子。",
   "ev": [
    [
     "cuhk",
     "甲金文象側面的大象之形。突出大象的長鼻子"
    ]
   ]
  },
  {
   "text": "商朝人见过真的大象。卜辞里写着“获象”：抓到了大象。",
   "ev": [
    [
     "cuhk",
     "《合集》10222：「隻(獲)象」"
    ]
   ]
  },
  {
   "text": "后来北方很少见到活象了。韩非子说：人们难得见到活的大象，只能捧着死象的骨头，照着图去想它活着的样子。所以，凡是心里想出来的样子，都叫做“象”。",
   "ev": [
    [
     "cuhk",
     "韓非認為由於北方少見大象，人們憑着象骨想像其形狀"
    ],
    [
     "hanfeizi",
     "人希見生象也，而得死象之骨，案其圖以想其生也，故諸人之所以意想者皆謂之「象」也"
    ]
   ]
  },
  {
   "text": "照这个说法，“想象”就是想着一头大象。再后来加了个“亻”，又分出了“像”字。",
   "ev": [
    [
     "cuhk",
     "故凡意想、想像皆稱「象」"
    ],
    [
     "cuhk",
     "後增「人」旁分化出「像」字"
    ]
   ]
  }
 ],
